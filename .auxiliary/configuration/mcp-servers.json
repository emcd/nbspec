{
  "mcpServers": {
    "agentmux": {
      "command": "agentmux",
      "args": [
        "host",
        "mcp",
        "--bundle",
        "notebook"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "nb": {
      "command": "nb-mcp",
      "args": [
        "--notebook",
        "nbspec",
        "--no-commit-signing"
      ]
    },
    "nbspec": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "serve",
        "mcp",
        "--notebook",
        "nbspec"
      ]
    }
  }
}
