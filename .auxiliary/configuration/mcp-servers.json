{
  "mcpServers": {
    "agentmux": {
      "command": "agentmux",
      "args": [
        "host", "mcp",
        "--default-bundle", "notebook"
      ],
      "env": {
        "AGENTMUX_BUNDLE": "${AGENTMUX_BUNDLE:-}",
        "AGENTMUX_SESSION": "${AGENTMUX_SESSION:-}",
        "AGENTMUX_CONFIGURATION_DIRECTORY": "${AGENTMUX_CONFIGURATION_DIRECTORY:-}",
        "AGENTMUX_STATE_DIRECTORY": "${AGENTMUX_STATE_DIRECTORY:-}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [ "-y", "@upstash/context7-mcp" ]
    },
    "nb": {
      "command": "nb-mcp",
      "args": [
        "--notebook", "nbspec",
        "--no-commit-signing"
      ]
    },
    "nbspec": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "serve", "mcp",
        "--notebook", "nbspec"
      ]
    }
  }
}
